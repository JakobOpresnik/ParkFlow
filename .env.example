# Production environment example for ParkFlow
# Values are injected by env-helper and CI/CD

DATABASE_URL=postgresql://parkflow:parkflow@db:5432/parkflow
PORT=3001
AUTHENTIK_USERINFO_URL=https://sso.example.com/application/o/userinfo/
AUTHENTIK_ADMIN_GROUP=parkflow-admins
JWT_SECRET=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TOKEN_URL=https://sso.matheo.si/application/o/token/
TIMESHEET_API_URL=https://timesheet.abelium.com/api

# Frontend
VITE_API_URL=http://backend:3001
VITE_OAUTH_AUTHORITY=https://sso.example.com/application/o/park-flow
VITE_OAUTH_CLIENT_ID=your-client-id
VITE_OAUTH_REDIRECT_URI=http://frontend:5173/callback
VITE_OAUTH_ADMIN_GROUP=parkflow-admins

# Docker image tag (auto-injected)
CI_COMMIT_TAG=
CI_REGISTRY_IMAGE=

