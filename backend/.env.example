DATABASE_URL=postgresql://user:password@localhost:5432/parkflow
PORT=3001
AUTHENTIK_USERINFO_URL=https://sso.matheo.si/application/o/userinfo/
AUTHENTIK_ADMIN_GROUP=parkflow-admins

JWT_SECRET=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TOKEN_URL=https://sso.matheo.si/application/o/token/

TIMESHEET_API_URL=

TIMESHEET_APP_ID=
TIMESHEET_SECRET=

# Rocket.Chat integration — shared secret the Rocket.Chat Outgoing WebHook sends
# in its "token" field; the backend rejects any request whose token doesn't match.
ROCKETCHAT_WEBHOOK_TOKEN=
# Outbound RocketChat Incoming Webhook URL — used to DM users when their
# reservation is released. Secret; backend only, never exposed to the frontend.
ROCKETCHAT_INCOMING_WEBHOOK_URL=
# Optional: base URL for the webhook's internal loopback calls
# (defaults to http://127.0.0.1:$PORT)
# INTERNAL_API_BASE_URL=http://127.0.0.1:3001
# Public URL of the ParkFlow frontend — used to build clickable map deep-links
# the bot sends. Defaults to localhost:3000 (prod is set in compose.yml).
# PUBLIC_FRONTEND_URL=https://parkflow.matheo.si

# Scheduled reminders — morning "you have a reservation today" (Docker cron + endpoint)
# Shared secret the reminders-cron sends as the X-Reminder-Token header; the
# endpoint rejects mismatches. Set it as a GitLab CI/CD variable (like JWT_SECRET
# / ROCKETCHAT_*) — the deploy job fills this empty value from that variable.
REMINDER_TRIGGER_TOKEN=
REMINDER_TZ=Europe/Ljubljana
REMINDER_MORNING_TIME=07:30

# Owners spot-owner export — shared secret the timesheet app sends as the
# X-Owners-Token header to GET /api/owners/timesheet-ids (numeric timesheet ids
# of spot owners); the endpoint rejects mismatches (and 500s if unset). Set it as
# a GitLab CI/CD variable like the other tokens above; the deploy job fills this
# empty value from that variable. (GET /api/owners/user-ids — SSO usernames — is
# unauthenticated and not gated by this token.)
OWNERS_API_TOKEN=
# Afternoon "free your spot if you won't need it" nudge to every spot owner.
# The reminders-cron fires it at this local time on Fridays; the endpoint also
# gates on it so a manual trigger before then is a no-op.
REMINDER_OWNER_TIME=15:00
